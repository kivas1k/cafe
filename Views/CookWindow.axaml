<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MyApp.Models"
        xmlns:conv="clr-namespace:MyApp.Converters"
        xmlns:views="clr-namespace:MyApp.Views"
        x:Class="MyApp.Views.CookWindow"
        Title="Повар"
        Width="950" Height="700">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Работа повара"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <ListBox x:Name="OrdersListBox"
                 Height="540"
                 DoubleTapped="OrdersListBox_DoubleTapped">

            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Order">
                    <Border Background="#FAFAFA"
                            CornerRadius="8"
                            Padding="14"
                            Margin="4"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">

                        <Grid ColumnDefinitions="80,110,*,150,120">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Id, StringFormat=№{0}}"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TableNumber, StringFormat=Стол {0}}"
                                       Foreground="#555"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Items}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}"
                                       Foreground="#6A1B9A"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Status}"
                                       FontWeight="Bold"
                                       Foreground="{Binding Status, Converter={x:Static views:StatusToBrushConverter.Instance}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Нет заказов"
                   FontSize="20"
                   Foreground="#999999"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding Items.Count, ElementName=OrdersListBox, Converter={StaticResource InverseBoolConverter}}"/>
    </StackPanel>
</Window>