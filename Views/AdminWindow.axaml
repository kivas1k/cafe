<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyApp.Views"
        xmlns:models="clr-namespace:MyApp.Models"
        x:Class="MyApp.Views.AdminWindow"
        Title="Администратор"
        Width="900" Height="650">

    <TabControl>
        <TabItem Header="Сотрудники">
            <StackPanel Spacing="10" Margin="10">
                <Button Content="Добавить сотрудника" Click="AddEmployee_Click" />
                <ListBox x:Name="EmployeesListBox" Height="300" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Просмотр/Редактирование" Click="ViewEmployee_Click" />
                    <Button Content="Уволить" Click="FireEmployee_Click" Background="#FF3B30" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Смены">
            <StackPanel Spacing="10" Margin="10">
                <Button Content="Создать смены на 5 дней" Click="CreateShiftsForWeek_Click" />
                <ListBox x:Name="ShiftsListBox" Height="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type views:ShiftDisplayItem}">
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
                                    <TextBlock Text="{Binding EmployeeCount, StringFormat='Сотрудников: {0}/7'}" />
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Назначить в смену" Click="AssignToShift_Click" />
                    <Button Content="Сотрудники в смене" Click="ViewShiftEmployees_Click" />
                    <Button Content="Удалить из смены" Click="RemoveFromShift_Click" Background="#FF3B30" Foreground="White" />
                    <Button Content="Удалить смену" Click="DeleteShift_Click" Background="#FF3B30" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Назначение столиков">
            <StackPanel Spacing="10" Margin="10">
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Выберите смену:" FontWeight="SemiBold"/>
                        <ListBox x:Name="TableAssignmentShiftsListBox" Height="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:ShiftDisplayItem}">
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="8" Margin="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Выберите официанта:" FontWeight="SemiBold"/>
                        <ListBox x:Name="TableAssignmentWaitersListBox" Height="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:User}">
                                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="8" Margin="2">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>

                <!-- ИСПРАВЛЕННЫЙ БЛОК ДЛЯ ВЫБОРА СТОЛИКА -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Background="#F8F9FA">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Номер столика:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <NumericUpDown x:Name="TableNumberBox" Minimum="1" Maximum="50" Value="1" Width="100" 
                                          FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" 
                                Content="Назначить столик" 
                                Click="AssignTable_Click"
                                Background="#1976D2"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="40"
                                Width="180"
                                Margin="10,0"
                                HorizontalAlignment="Center"/>
                        
                        <Button Grid.Column="2" 
                                Content="Снять назначение" 
                                Click="UnassignTable_Click"
                                Background="#FF3B30"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="40"
                                Width="180"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <TextBlock Text="Текущие назначения столиков:" FontWeight="SemiBold" FontSize="16"/>
                <ListBox x:Name="TableAssignmentsListBox" Height="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TableAssignment}">
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2" Background="#FAFAFA">
                                <Grid ColumnDefinitions="80,*,150">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding TableNumber, StringFormat=Стол {0}}"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding WaiterName}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding AssignedAt, StringFormat='Назначен: {0:HH:mm}'}"
                                               Foreground="#666"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <TextBlock x:Name="TableAssignmentInfoText" Text="Выберите смену и официанта для назначения столиков."/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Заказы">
            <StackPanel Spacing="10" Margin="10">
                <ListBox x:Name="OrdersListBox" Height="380">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Order}">
                            <Border Background="#FAFAFA" Padding="12,10" Margin="2" CornerRadius="6">
                                <TextBlock FontSize="15" FontWeight="Medium">
                                    <Run Text="Стол "/>
                                    <Run Text="{Binding TableNumber}" FontWeight="Bold"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding TotalAmount, StringFormat={}{0:C}}" Foreground="#2E7D32" FontWeight="Bold"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Foreground="#666"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Редактировать заказ" Click="EditOrder_Click" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Отчёты">
            <StackPanel Spacing="10" Margin="10">
                <Button Content="Отчёт по заказам (PDF)" Click="GenerateOrdersReportPdf_Click" />
                <Button Content="Отчёт по выручке (XLSX)" Click="GenerateRevenueReportXlsx_Click" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>