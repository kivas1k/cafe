<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyApp.Views.OrderEditWindow"
        Title="Редактирование заказа"
        Width="500"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <StackPanel Margin="24">
        <StackPanel.Spacing>16</StackPanel.Spacing>
        
        <TextBlock Text="Редактирование заказа"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#333"/>

        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                BoxShadow="0 4 20 0 #20000000">

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!-- Заголовок -->
                <TextBlock x:Name="TitleText" Grid.Row="0"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1565C0"/>

                <!-- Стол и гости -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Номер стола:" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBox x:Name="TableNumberBox" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Количество гостей:" FontWeight="SemiBold" Foreground="#555"/>
                        <TextBox x:Name="CustomersCountBox" FontSize="16"/>
                    </StackPanel>
                </Grid>

                <!-- Дата и время -->
                <TextBlock x:Name="CreatedAtText" Grid.Row="2"
                           FontSize="14"
                           Foreground="#666"
                           Margin="0,8,0,16"/>

                <Separator Grid.Row="3" Background="#EEEEEE" Height="1"/>

                <!-- Состав заказа -->
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <StackPanel.Spacing>8</StackPanel.Spacing>
                    <TextBlock Text="Состав заказа:" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox x:Name="ItemsBox" 
                             TextWrapping="Wrap"
                             FontSize="16"
                             Height="100"
                             AcceptsReturn="True"/>
                </StackPanel>

                <!-- Сумма -->
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <StackPanel.Spacing>8</StackPanel.Spacing>
                    <TextBlock Text="Сумма (₽):" FontWeight="SemiBold" Foreground="#555"/>
                    <TextBox x:Name="AmountBox" 
                             FontSize="16"
                             FontWeight="Bold"/>
                </StackPanel>

                <Separator Grid.Row="6" Background="#EEEEEE" Height="1" Margin="0,16"/>

                <!-- Статус -->
                <StackPanel Grid.Row="7" Margin="0,16,0,0">
                    <StackPanel.Spacing>8</StackPanel.Spacing>
                    <TextBlock Text="Статус заказа:" FontWeight="SemiBold" Foreground="#555"/>
                    <ComboBox x:Name="StatusComboBox" 
                              FontSize="16"
                              Height="40"
                              SelectionChanged="StatusComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Способ оплаты (если оплачен) -->
                <StackPanel x:Name="PaymentMethodPanel" Grid.Row="8" Margin="0,16,0,0" IsVisible="False">
                    <StackPanel.Spacing>8</StackPanel.Spacing>
                    <TextBlock Text="Способ оплаты:" FontWeight="SemiBold" Foreground="#555"/>
                    <ComboBox x:Name="PaymentMethodComboBox" 
                              FontSize="16"
                              Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
            <Button Content="Сохранить"
                    Click="Save_Click"
                    Background="#1976D2"
                    Foreground="White"
                    FontSize="16"
                    Height="52"
                    CornerRadius="12"
                    Margin="0,0,5,0"/>

            <Button Grid.Column="1"
                    Content="Оплатить"
                    x:Name="PayButton"
                    Click="Pay_Click"
                    Background="#2E7D32"
                    Foreground="White"
                    FontSize="16"
                    Height="52"
                    CornerRadius="12"
                    Margin="5,0,0,0"/>
        </Grid>
    </StackPanel>
</Window>