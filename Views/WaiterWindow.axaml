<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MyApp.Views"
        xmlns:models="clr-namespace:MyApp.Models"
        xmlns:conv="clr-namespace:MyApp.Converters"
        x:Class="MyApp.Views.WaiterWindow"
        Title="Официант"
        Width="950" Height="700">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <views:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>

    <StackPanel Margin="20" Spacing="12">

        <TextBlock Text="Работа официанта" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

        <!-- Панель контроля смены и кнопки -->
        <Grid ColumnDefinitions="*,*,*,auto" Margin="0,0,0,6">
            <Button x:Name="CreateOrderBtn" Content="Создать заказ" Click="CreateOrder_Click" Margin="5"/>
            <Button x:Name="PayOrderBtn" Content="Оплата" Grid.Column="1" Click="PayOrder_Click" Margin="5"/>
            <Button Content="Отчёт по смене" Grid.Column="2" Click="OpenShiftReport_Click" Margin="5"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="ShiftInfoText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button x:Name="ToggleShiftBtn" Content="Открыть смену" Click="ToggleShift_Click" />
            </StackPanel>
        </Grid>

        <!-- СПИСОК ЗАКАЗОВ -->
        <ListBox x:Name="OrdersListBox" Height="520" Margin="0,6,0,0"
                 DoubleTapped="OrdersListBox_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Order}">
                    <Border Background="#FAFAFA" CornerRadius="8" Padding="12" Margin="4" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid ColumnDefinitions="64,100,*,140,110">
                            <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat=№{0}}" FontWeight="Bold" Foreground="#1976D2"/>
                            <TextBlock Grid.Column="1" Text="{Binding TableNumber, StringFormat=Стол {0}}" Foreground="#555"/>
                            <TextBlock Grid.Column="2" Text="{Binding Items}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat={}{0:C}}" FontWeight="SemiBold" Foreground="#2E7D32"/>
                            <TextBlock Grid.Column="4" Text="{Binding Status}" FontWeight="Bold" 
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Заказов пока нет. Нажмите «Создать заказ»" FontSize="20" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Items.Count, ElementName=OrdersListBox, Converter={StaticResource InverseBoolConverter}}"/>
    </StackPanel>
</Window>